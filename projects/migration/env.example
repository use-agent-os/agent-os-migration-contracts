# ---------- RPC ----------
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ---------- Deployer ----------
# Deployer EOA. It only pays gas: it never has any role on either contract.
# Name of a Foundry keystore, never a raw private key. Create it once with:
#   cast wallet import migration-deployer --interactive
# forge asks for the keystore password when the deploy script runs.
DEPLOYER_ACCOUNT=migration-deployer

# ---------- Shared ----------
# Team Safe. Owner of both contracts. Must be the Safe on the chain being deployed to
# (threshold >= 2 is enforced by the deploy scripts).
OWNER=

# ---------- MigrationVault (Base, 8453) ----------
CAP_TOKEN=0xbfa733702305280F066D470afDFA784fA70e2649
DACKIE_TOKEN=0x73326b4d0225c429bed050c11C4422d91470AaF4
# 2026-11-25 00:00:00 UTC
DEPOSIT_START=1795564800
# 2026-12-25 23:59:59 UTC (inclusive)
DEPOSIT_DEADLINE=1798243199
# Hard ceiling for extendDeadline: 2027-01-31 23:59:59 UTC
MAX_DEPOSIT_DEADLINE=1801439999
# Rates must be final at least this long before the deadline (15 days)
MIN_RATE_NOTICE=1296000
# Root attestation -> release delay (24 hours)
RELEASE_DELAY=86400
# No release within this long after the deadline => permissionless refunds (14 days)
SETTLEMENT_GRACE=1209600
# Most AGENTOS the deposits may convert to: 4.20B, 18 decimals. Once the rates are set, a deposit that
# would go above it is refused. Leaves approximately 0.80B of the 5B budget for long-lock allocations
# (~0.76B at the indicative rate). Team deposits count against it. Immutable after deployment.
MAX_DEPOSIT_ALLOCATION=4200000000000000000000000000
# Optional independent veto: may only cancel between the root attestation and the release.
# Leave unset to disable. Must not be the Safe. See README "Guardian" before enabling.
# GUARDIAN=

# ---------- Blocklist (scripts/BlocklistBatches.s.sol, executed by the Safe) ----------
# VAULT=
# BLOCKLIST_FILE=configs/blocklist.txt
# BLOCKLIST_BATCH=400
# BLOCKLIST_TX_PER_FILE=3

# ALLOW_EOA_OWNER / ALLOW_ANY_CHAIN exist for testnet dry runs only. The deploy scripts revert if
# either is set to true on Base (8453) or Robinhood (4663). Do not put them in this file.

# ---------- MerkleVestingDistributor (Robinhood, 4663) ----------
AGENTOS_TOKEN=0x6eDA83Fc299C10d474068A7E69771c809Bcbbba3
# Budget ceiling: 5B AGENTOS (5% of supply), 18 decimals
MAX_TOTAL_ALLOCATION=5000000000000000000000000000
